## Skopiuj ten plik jako .env i uzupelnij prawdziwe wartosci.
## Plik .env NIGDY nie powinien trafic do repozytorium.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://secureware.pl
APP_NAME="SecureWare"

# Sciezka panelu administracyjnego (bez ukosnikow), np. wynik: /cloudsecurepanel
ADMIN_PATH=cloudsecurepanel

DB_HOST=localhost
DB_PORT=3306
DB_NAME=secureware
DB_USER=secureware
DB_PASS=change-me
DB_CHARSET=utf8mb4

# Sesja / bezpieczenstwo
SESSION_NAME=sw_session
SESSION_SECURE=true

# Cloudflare Turnstile (formularz kontaktowy) - https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Poczta wychodzaca (powiadomienia o nowych leadach)
MAIL_FROM=no-reply@secureware.pl
MAIL_TO=kontakt@secureware.pl
