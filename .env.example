## Skopiuj ten plik jako .env i uzupelnij prawdziwe wartosci.
## Plik .env NIGDY nie powinien trafic do repozytorium.
##
## Wszystko, co da sie skonfigurowac z poziomu panelu admina (branding,
## Turnstile, Google Analytics, CookieYes, adres nadawcy poczty itd.) NIE
## jest tutaj - patrz Ustawienia -> Branding / Integracje po zalogowaniu.
## Tu zostaje wylacznie baza danych i kilka wartosci infrastrukturalnych,
## ktore musza byc dostepne zanim aplikacja w ogole polaczy sie z baza.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://secureware.pl

# Sciezka panelu administracyjnego (bez ukosnikow), np. wynik: /cloudsecurepanel
ADMIN_PATH=cloudsecurepanel

DB_HOST=localhost
DB_PORT=3306
DB_NAME=secureware
DB_USER=secureware
DB_PASS=change-me
DB_CHARSET=utf8mb4

# Sesja / bezpieczenstwo
SESSION_NAME=sw_session
SESSION_SECURE=true
