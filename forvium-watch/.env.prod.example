# Forvium Watch - konfiguracja produkcyjna (compose.prod.yaml).
# Skopiuj do /opt/forvium-watch/.env i ustaw prawa: chown root:root .env && chmod 600 .env
# Hasla i klucze generuj na serwerze (patrz docs/wdrozenie-almalinux-10.md), nie kopiuj z przykladow.

# Stala nazwa projektu compose (nazwy wolumenow, np. forvium-watch_backups).
COMPOSE_PROJECT_NAME=forvium-watch
# Uslugi z profili uruchamiane razem ze stosem (monitoring: Prometheus, Alertmanager, Grafana).
# COMPOSE_PROFILES=monitoring

# Domena: panele pod app.<domena>, admin.<domena>, API pod api.<domena>.
FORVIUM_DOMAIN=forvium.example.com

# --- PostgreSQL (hasla rol; ustawiane przy pierwszym starcie bazy) ---
FORVIUM_POSTGRES_PASSWORD=
FORVIUM_MIGRATOR_PASSWORD=
FORVIUM_APP_PASSWORD=
FORVIUM_BACKUP_PASSWORD=
FORVIUM_RESTORE_PASSWORD=

# --- Klucze danych (szyfrowanie sekretow, MFA, nagran, raportow) ---
# Wariant A (prosty): klucz w tym pliku, format kid:base64 (32 bajty).
FORVIUM_DATA_KEYS=
FORVIUM_DATA_KEY_ID=
# Wariant B (zalecany): klucze zaszyfrowane w Vault Transit - wtedy zostaw A puste.
# FORVIUM_DATA_KEYS_WRAPPED=
# FORVIUM_VAULT_ADDR=https://vault.example.com
# FORVIUM_VAULT_TOKEN=

# --- Audyt ---
# Klucz HMAC lancucha skrotow eksportu audytu (min. 32 losowe znaki).
FORVIUM_AUDIT_EXPORT_HMAC_KEY=
# Opcjonalnie: wlasny odbiornik HTTP (partie JSON podpisane HMAC).
# FORVIUM_AUDIT_EXPORT_URL=
# Opcjonalnie: SIEM - patrz deploy/siem/README.md
# FORVIUM_AUDIT_SIEM_TYPE=elastic            # splunk | elastic | syslog
# FORVIUM_AUDIT_SIEM_URL=https://elastic.example.com:9200
# FORVIUM_AUDIT_SIEM_TOKEN=                  # Splunk: token HEC; Elastic: klucz API (encoded)
# FORVIUM_AUDIT_SIEM_INDEX=                  # Splunk: indeks; Elastic: data stream
# FORVIUM_AUDIT_SIEM_CA_FILE=/etc/forvium/siem-ca.pem   # zamontuj w compose.site.yaml

# --- Poczta (powiadomienia, linki aktywacyjne) ---
FORVIUM_SMTP_HOST=smtp.example.com
FORVIUM_SMTP_PORT=587
FORVIUM_SMTP_USERNAME=
FORVIUM_SMTP_PASSWORD=
FORVIUM_SMTP_STARTTLS=true
FORVIUM_SMTP_FROM=Forvium Watch <no-reply@forvium.example.com>
FORVIUM_SECURITY_TEAM_EMAILS=security@forvium.example.com
# Jezyk domyslny: pl | en (organizacja i uzytkownik moga miec wlasny - panel admin / przelacznik PL|EN)
FORVIUM_DEFAULT_LOCALE=pl

# --- Bezpieczenstwo ---
FORVIUM_BREAK_GLASS_ENABLED=false
FORVIUM_OPERATOR_LOGIN_WEBAUTHN_ONLY=true
FORVIUM_API_REPLICAS=2
# Procesy uvicorn na replike API (zalecenia: deploy/loadtest/README.md)
FORVIUM_API_WORKERS=2
# Limity bramy na adres IP (klienci za NAT-em dziela adres): API i logowanie
FORVIUM_RATE_API=50r/s
FORVIUM_BURST_API=100
FORVIUM_RATE_AUTH=10r/m

# --- Kopie zapasowe ---
# Klucz PUBLICZNY age (age1...). Klucz prywatny przechowuj poza serwerem (sejf, HSM).
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=14
# Automatyczny test odtwarzania (s; 0 = wylaczony - wtedy serwer nie ma zadnego klucza prywatnego).
RESTORE_TEST_INTERVAL_SECONDS=604800

# --- Monitoring (profil "monitoring") ---
FORVIUM_GRAFANA_PASSWORD=
# FORVIUM_METRICS_TOKEN=
