generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      Plan     @default(STARTER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  incidents Incident[]
  assets    Asset[]
  risks     Risk[]
  controls  IsoControl[]
}

enum Plan {
  STARTER
  STANDARD
  PRO
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  password       String?      @db.Text
  role           UserRole     @default(ABSI)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  accounts Account[]
  sessions Session[]
}

enum UserRole {
  OWNER
  ABSI
  READONLY
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Incident {
  id                     String           @id @default(cuid())
  incidentNumber         String
  title                  String
  description            String           @db.Text
  severity               IncidentSeverity
  status                 IncidentStatus   @default(NEW)
  category               IncidentCategory
  reportedBy             String
  assignedTo             String?
  nis2Active                  Boolean          @default(false)
  nis2StartedAt               DateTime?
  nis2EarlyWarningSentAt      DateTime?
  nis2ReportSentAt            DateTime?
  reminder24hSentAt           DateTime?
  reminder72hSentAt           DateTime?
  reminder30dSentAt           DateTime?
  closedAt               DateTime?
  closureRootCause       String?          @db.Text
  closureActions         String?          @db.Text
  closurePreventive      String?          @db.Text
  organizationId         String
  organization           Organization     @relation(fields: [organizationId], references: [id])
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deletedAt              DateTime?

  actions   IncidentAction[]
  evidences Evidence[]
  assets    IncidentAsset[]
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  NEW
  IN_PROGRESS
  ANALYSIS
  CLOSED
}

enum IncidentCategory {
  UNAUTHORIZED_ACCESS
  DATA_LEAK
  AVAILABILITY
  PHISHING
  MALWARE
  PHYSICAL
  OTHER
}

model IncidentAction {
  id         String   @id @default(cuid())
  content    String   @db.Text
  authorId   String
  authorName String
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  createdAt  DateTime @default(now())
}

model Evidence {
  id          String   @id @default(cuid())
  filename    String
  storagePath String
  size        Int
  mimeType    String
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id])
  uploadedBy  String
  createdAt   DateTime @default(now())
}

model Asset {
  id             String         @id @default(cuid())
  assetNumber    String
  name           String
  type           AssetType
  classification Classification
  description    String?        @db.Text
  location       String?
  businessOwner  String?
  technicalOwner String?
  nextReviewAt   DateTime?
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  history   AssetHistory[]
  incidents IncidentAsset[]
  risks     RiskAsset[]
}

enum AssetType {
  HARDWARE
  SOFTWARE
  DATA
  CLOUD_SERVICE
  INFRASTRUCTURE
  OTHER
}

enum Classification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

model AssetHistory {
  id        String   @id @default(cuid())
  field     String
  oldValue  String?
  newValue  String?
  changedBy String
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  createdAt DateTime @default(now())
}

model IncidentAsset {
  incidentId String
  assetId    String
  incident   Incident @relation(fields: [incidentId], references: [id])
  asset      Asset    @relation(fields: [assetId], references: [id])

  @@id([incidentId, assetId])
}

model Risk {
  id              String        @id @default(cuid())
  riskNumber      String
  title           String
  description     String        @db.Text
  threat          String?       @db.Text
  vulnerability   String?       @db.Text
  category        RiskCategory  @default(OTHER)
  probability     Int
  impact          Int
  riskScore       Int
  treatment       RiskTreatment @default(MITIGATE)
  status          RiskStatus    @default(OPEN)
  owner           String
  mitigationPlan  String?       @db.Text
  residualProb    Int?
  residualImpact  Int?
  residualScore   Int?
  nextReviewAt          DateTime?
  reviewReminderSentAt  DateTime?
  closedAt              DateTime?
  organizationId        String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  assets RiskAsset[]
}

model RiskAsset {
  riskId  String
  assetId String
  risk    Risk  @relation(fields: [riskId], references: [id])
  asset   Asset @relation(fields: [assetId], references: [id])

  @@id([riskId, assetId])
}

enum RiskCategory {
  CONFIDENTIALITY
  INTEGRITY
  AVAILABILITY
  PHYSICAL
  LEGAL
  OTHER
}

enum RiskTreatment {
  ACCEPT
  MITIGATE
  TRANSFER
  AVOID
}

enum RiskStatus {
  OPEN
  IN_TREATMENT
  ACCEPTED
  CLOSED
}

model IsoControl {
  id             String        @id @default(cuid())
  controlNumber  String
  status         ControlStatus @default(NOT_REVIEWED)
  justification  String?       @db.Text
  owner          String?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, controlNumber])
}

enum ControlStatus {
  NOT_REVIEWED
  APPLICABLE
  PLANNED
  EXCLUDED
  NOT_APPLICABLE
}
